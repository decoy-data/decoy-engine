# Import-layer contract for decoy_engine (LAYOUT E3). Tiers run top to bottom: a module may
# import from its own tier (`:` siblings) and from any tier below, never from a tier above.
# exhaustive = true: a new top-level package or module is red until it is placed here and in
# the snapshot in tests/sentry/layout/test_import_layers.py. Each ignore line is a measured
# back import that exists today; the list may only shrink (baseline import-layers.json).
# In the tiers contract both sides of an ignore name a leaf module, never a package: import-linter
# exempts the whole module edge, so an ignore on a package facade would let every later symbol
# through it. The policy-direction contract at the end follows the same rule for the importer;
# its imported side may be the forbidden package itself.

[importlinter]
root_package = decoy_engine

[importlinter:contract:layers]
name = decoy_engine tiers
type = layers
containers = decoy_engine
exhaustive = true
layers =
    unmask : delivery : walks : identifiers : providers : records : support
    execution : kernel : quarantine : publication : validation : verification : vault
    plan : generation : generators : transforms : declared_casting : secret_providers : keyprovider : relationships : providers_v2 : reference_tables : quality : subset
    profile : profiling : detection : internal : progress : context : config : determinism : contracts : connectors : expressions : validators : sdk : run_result : signed_evidence
    io : data_discovery : disguises : phase : telemetry : safe_output : fileaccess
    errors : reason_adapter : validation_result : release : reasons : instrumentation : checksums : _opaque : _lexeme : _error_base : _progress_events : _reference_date : _capacity : codesets : _execution_error : _field_names : _value_free : _arrow_types : _canonical : _pandas_meta : _nested_json : _duckdb_read
ignore_imports =
    decoy_engine.config._generate_unique -> decoy_engine.generation.pool._capacity
    decoy_engine.declared_casting._boundary -> decoy_engine.execution._errors
    decoy_engine.declared_casting._boundary -> decoy_engine.execution._pipeline_sources
    decoy_engine.declared_casting._cleanup -> decoy_engine.execution._errors
    decoy_engine.declared_casting._eligibility -> decoy_engine.execution._errors
    decoy_engine.declared_casting._quarantine_local -> decoy_engine.execution._errors
    decoy_engine.declared_casting._stream -> decoy_engine.execution.out_of_core._budget
    decoy_engine.declared_casting._stream -> decoy_engine.execution.out_of_core._scratch
    decoy_engine.errors -> decoy_engine.execution._row_error_summary
    decoy_engine.fileaccess._errors -> decoy_engine.execution._isolated_common
    decoy_engine.generation._bounds -> decoy_engine.execution.out_of_core._budget
    decoy_engine.generation._streamed -> decoy_engine.execution._chunked_output_sink
    decoy_engine.generation._streamed -> decoy_engine.execution._mem_estimate
    decoy_engine.generation._streamed -> decoy_engine.execution.out_of_core._budget
    decoy_engine.generation.pool._sampler -> decoy_engine.execution.native._crypto_ext
    decoy_engine.generation.pool._sampler -> decoy_engine.execution.native._index_ext
    decoy_engine.internal.faker_setup -> decoy_engine.generation._dob_anchor
    decoy_engine.plan._checks_bucketize -> decoy_engine.execution._strategies._bucketize
    decoy_engine.plan._checks_correctness -> decoy_engine.execution._errors
    decoy_engine.plan._checks_correctness -> decoy_engine.execution.out_of_core._mask
    decoy_engine.plan._checks_top_code -> decoy_engine.execution._strategies._top_code
    decoy_engine.plan._seed_envelope -> decoy_engine.execution._technique_class
    decoy_engine.profile._declared_columns -> decoy_engine.execution._pipeline_context
    decoy_engine.profile._declared_columns -> decoy_engine.execution._transforms
    decoy_engine.profiling._scan_integrity -> decoy_engine.execution.out_of_core._duckdb
    decoy_engine.profiling._snapshot_values -> decoy_engine.generation.pool._events
    decoy_engine.profiling._snapshot_values -> decoy_engine.quality.snapshot
    decoy_engine.profiling.scan_set -> decoy_engine.execution._guards
    decoy_engine.telemetry._recorder -> decoy_engine.progress
    decoy_engine.telemetry._vocab -> decoy_engine.progress

# Policy direction (R1, engine clean-architecture review 2026-11-21, "The layer sentry" rec. 3).
# The tier order above is a measured order, so `connectors`, `io` and `fileaccess` sit below
# `plan` and a new policy -> I/O import would pass it. This contract forbids those edges
# outright. Every ignore is an edge that exists today (debt for QA and 1.x, not endorsed); the
# list may only shrink. The importer is always a leaf module. The imported side is a package only
# where the forbidden module is itself that package (`fileaccess`, `publication`).
# Record: 10_Projects/decoy/records/2026-11-21-engine-clean-architecture-review.md.
[importlinter:contract:policy-direction]
name = policy packages do not import I/O or backends
type = forbidden
source_modules =
    decoy_engine.plan
    decoy_engine.config
    decoy_engine.reasons
    decoy_engine.contracts
    decoy_engine.expressions
    decoy_engine.relationships
    decoy_engine.delivery
    decoy_engine.determinism
forbidden_modules =
    decoy_engine.connectors
    decoy_engine.io
    decoy_engine.fileaccess
    decoy_engine.publication
    decoy_engine.vault
    decoy_engine.unmask
    decoy_engine.execution
allow_indirect_imports = true
ignore_imports =
    # finding 1: strategy policy lives in execution
    decoy_engine.plan._checks_bucketize -> decoy_engine.execution._strategies._bucketize
    # finding 1: strategy policy lives in execution
    decoy_engine.plan._checks_correctness -> decoy_engine.execution._errors
    # finding 1: strategy policy lives in execution
    decoy_engine.plan._checks_correctness -> decoy_engine.execution.out_of_core._mask
    # finding 1: strategy policy lives in execution
    decoy_engine.plan._checks_top_code -> decoy_engine.execution._strategies._top_code
    # finding 1: strategy policy lives in execution
    decoy_engine.plan._seed_envelope -> decoy_engine.execution._technique_class
    # finding 8: plan compile reads files
    decoy_engine.plan._compile -> decoy_engine.fileaccess
    # finding 8: plan compile reads files
    decoy_engine.plan._generation -> decoy_engine.fileaccess
    # finding 8: plan compile reads files
    decoy_engine.plan._serialize -> decoy_engine.fileaccess
    # finding 8: plan compile reads files
    decoy_engine.plan.checks._lookup_tables -> decoy_engine.fileaccess
    # finding 8: plan compile reads files
    decoy_engine.plan.validate._consolidator -> decoy_engine.fileaccess
    # finding not numbered in the record; delivery resume reads publication
    decoy_engine.delivery.resume._records -> decoy_engine.publication
